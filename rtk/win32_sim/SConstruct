import os
import sys
import menu_config
from SCons.Script import *
import subprocess
import platform
import uuid

TOOL_ROOT="../tool/scons-tool"

sys.path = sys.path + [os.path.join(TOOL_ROOT, '')]
try:
    from building import *
except:
    print('Cannot found Scons tool root directory, please check TOOL_ROOT')
    exit(-1)

TARGET = 'gui.' + 'exe'

# ============================================================================
# Kconfig Integration
# ============================================================================

print("=" * 60)
print("LVGL v9 Win32 Simulator - SCons Build")
print("=" * 60)

# Check if .config exists
config_file = '.config'
if os.path.exists(config_file):
    print(f"Found {config_file}, parsing configuration...")
    
    # Generate config files from .config
    try:
        # Generate CMake config (for reference)
        subprocess.run([
            'python', 'parse_kconfig.py', 
            config_file, 'config.cmake', 'cmake'
        ], check=True)
        print("Generated config.cmake")
        
        # Note: autoconfig.h generation removed - not used in current architecture
        # LVGL uses lv_conf.h instead of Kconfig when LV_KCONFIG_IGNORE is set
        
    except subprocess.CalledProcessError as e:
        print(f"Warning: Failed to generate config files: {e}")
else:
    print(f"Warning: {config_file} not found!")
    print("Run 'python menu_config.py' or 'menuconfig.bat' to generate it.")
    print("Using default configuration...")

print("=" * 60)

# ============================================================================
# Build Environment Setup
# ============================================================================

env = Environment(tools = ['mingw'],
                  CC=menu_config.CC, CFLAGS = menu_config.CFLAGS,
                  CXX = menu_config.CXX, CXXFLAGS = menu_config.CXXFLAGS,
                  LINKFLAGS = menu_config.LFLAGS)

# Add current directory to include path for generated files
env.Append(CPPPATH = [os.getcwd()])

env.Append(LIBS = ['mingw32'])
env.Append(LIBS = ['opengl32'])

DEMO_ROOT = os.path.abspath('./../demos')
LVGLV9_ROOT = os.path.abspath('./../../')
PLATFORM = menu_config.PLATFORM

Export('PLATFORM')
Export('TOOL_ROOT')
Export('DEMO_ROOT')
Export('LVGLV9_ROOT')

print("CC: ", env['CC'])
print("CCFLAGS: ", env['CCFLAGS'])
print("CXXFLAGS: ", env['CXXFLAGS'])
print("LINKFLAGS: ", env['LINKFLAGS'])
print('TOOL ROOT = ' + TOOL_ROOT)
print('DEMO ROOT = ' + DEMO_ROOT)
print('LVGLV9 ROOT = ' + LVGLV9_ROOT)

# ============================================================================
# Prepare Building Environment
# ============================================================================

# prepare building environment
objs = PrepareBuilding(env, TOOL_ROOT, has_libcpu=False)

# PrepareBuilding may return None if no SConscript exists in current directory
if objs is None:
    objs = []
# set spawn: save & load long param as temp file
def ourspawn(sh, escape, cmd, args, e):
    filename = str(uuid.uuid4())
    newargs = ' '.join(args[1:])
    cmdline = cmd + " " + newargs
    if (len(cmdline) > 16 * 1024):
        f = open(filename, 'w')
        f.write(' '.join(args[1:]).replace('\\', '/'))
        f.close()
        # exec
        cmdline = cmd + " @" + filename
    proc = subprocess.Popen(cmdline, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, shell = False, env = e)
    data, err = proc.communicate()
    rv = proc.wait()
    def res_output(_output, _s):
        if len(_s):
            if isinstance(_s, str):
                _output(_s)
            elif isinstance(_s, bytes):
                _output(str(_s, 'UTF-8'))
            else:
                _output(str(_s))
    res_output(sys.stderr.write, err)
    res_output(sys.stdout.write, data)
    if os.path.isfile(filename):
        os.remove(filename)
    return rv

if platform.system() == 'Windows':
    env['SPAWN'] = ourspawn

# ============================================================================
# Include Subdirectories
# ============================================================================

# include LVGL and demos
objs.extend(SConscript(os.path.join(LVGLV9_ROOT, 'SConscript')))
objs.extend(SConscript(os.path.join(DEMO_ROOT, 'SConscript')))

# ============================================================================
# Build Target
# ============================================================================

# make a building
DoBuilding(TARGET, objs)
